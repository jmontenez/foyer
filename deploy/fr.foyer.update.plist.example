<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchDaemon (/Library/LaunchDaemons), exécuté sous le compte de service, jamais root. -->
<plist version="1.0"><dict>
  <key>Label</key><string>fr.foyer.update</string>
  <key>UserName</key><string>foyer</string>
  <key>GroupName</key><string>staff</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/python3.12</string>
    <string>/Users/foyer/foyer/scripts/deploy/auto_update.py</string>
    <string>--app</string><string>/Users/foyer/foyer</string>
    <string>--updates</string><string>/Users/foyer/.foyer-updates</string>
    <string>--token-file</string><string>/Users/foyer/.foyer-secrets/github-token</string>
    <string>--state</string><string>/Users/foyer/.foyer-deploy.json</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/foyer/foyer</string>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/Users/foyer</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string>
    <key>DOCKER_HOST</key><string>unix:///Users/foyer/.colima/foyer/docker.sock</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>/Users/foyer/Library/Logs/foyer-update.log</string>
  <key>StandardErrorPath</key><string>/Users/foyer/Library/Logs/foyer-update.log</string>
</dict></plist>
