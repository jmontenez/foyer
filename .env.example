# Configuration non secrète. Copier en .env et compléter sur la machine cible.
PUBLIC_ORIGIN=https://foyer.example.invalid
# Derrière Cloudflare Tunnel (port API loopback uniquement) : CF-Connecting-IP.
# Laisser vide si l'API est jointe directement, sans proxy de confiance.
CLIENT_IP_HEADER=CF-Connecting-IP
ALLOWED_EMAILS=compte1@example.invalid,compte2@example.invalid
GOOGLE_CLIENT_ID=REMPLACER.apps.googleusercontent.com
FIREBASE_PROJECT_ID=REMPLACER
FOYER_SECRETS_DIR=./.secrets
# Répertoire des mises à jour Android servies aux membres (scripts/android_update.py).
FOYER_UPDATES_DIR=./updates
# Laisser false pendant toute restauration/test. Passer true sur la seule instance active.
WORKERS_ENABLED=false
